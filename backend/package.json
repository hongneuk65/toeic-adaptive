  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:learning:integration": "npm run build && node test/learning.integration.cjs",
    "seed:skills": "ts-node prisma/seed-skills.ts",
    "seed:bulk-questions": "ts-node prisma/seed-questions-bulk.ts",
    "seed:knowledge": "ts-node prisma/seed-knowledge.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "seed:theory": "ts-node prisma/seed-theory.ts",
    "seed:weights": "ts-node prisma/seed-weights.ts",
    "seed:demo": "npm run seed:skills && npm run seed:weights && npm run seed:theory && npm run seed:bulk-questions && npm run seed:knowledge"
  },
