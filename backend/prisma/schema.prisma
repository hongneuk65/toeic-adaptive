generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  googleSubject String? @unique
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ability Float @default(0.0)
  learningPreferences Json?
  placementAttempts PlacementAttempt[]
  trainedDas3hStates TrainedDas3hState[]
  trainedDas3hObservations TrainedDas3hObservation[]

  examAttempts          ExamAttempt[]
  folders               FlashcardFolder[]
  flashcards            Flashcard[]
  studentSkillHistories StudentSkillHistory[]
  userSkillMasteries    UserSkillMastery[]
  aiChatMessages        AiChatMessage[]
  listeningSources      ListeningSource[]
  listeningSessions     ListeningSession[]
  listeningReports      ListeningReport[]
  readingArticles ReadingArticle[]
  readingAttempts ReadingAttempt[]
  readingReports ReadingReport[]
  readingAiEvents ReadingAiEvent[]
  flashcardReviews FlashcardReview[]
}

model PlacementAttempt {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  status String @default("ACTIVE")
  revision Int @default(0)
  seed String
  policyVersion String
  goal String
  targetScore Int?
  issued Json
  responses Json
  result Json?
  startedAt DateTime @default(now())
  deadlineAt DateTime
  completedAt DateTime?
  @@index([userId, startedAt])
}

model Skill {
  id        Int      @id @default(autoincrement())
  code      String   @unique // Ví dụ: P1_PHOTO_OBJECT, P5_TENSE,...
  name      String
  part      Int // Part 1 -> 7 (7 gồm 7A Single, 7B Multiple)
  category  String // Ngữ pháp, Từ vựng, Suy luận, Ý chính,...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  easiness Float @default(0.0)

  questions             QuestionSkill[]
  theoryLessons         TheoryLesson[]
  das3hWeights          Das3hWeights?
  studentSkillHistories StudentSkillHistory[]
  userSkillMasteries    UserSkillMastery[]

  @@index([part])
}

model Question {
  id             Int        @id @default(autoincrement())
  part           Int // 1 đến 7
  passage        String? // Đoạn văn đọc (dành cho Part 6, 7)
  audioUrl       String? // Link file âm thanh (dành cho Part 1-4)
  imageUrl       String? // Link ảnh (Part 1 hoặc biểu đồ Part 3, 4, 7)
  stimulus       Json? // Structured source documents, tables, blanks and group position
  content        String // Nội dung câu hỏi
  optionA        String
  optionB        String
  optionC        String
  optionD        String
  correctAnswer  String // "A", "B", "C", hoặc "D"
  explanation    String? // Lời giải thích đáp án
  difficulty     Difficulty @default(MEDIUM)
  itemDifficulty Float // δ_j (Equated Delta khởi tạo theo Part)
  totalAttempts  Int        @default(0)
  totalCorrect   Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  skills                QuestionSkill[]

  @@index([part])
  @@index([difficulty])
}

// Bảng trung gian hiện thực hóa quan hệ nhiều-nhiều (Q-matrix)
model QuestionSkill {
  questionId Int
  skillId    Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([questionId, skillId])
  @@index([skillId])
  @@index([questionId])
}

model Flashcard {
  id        Int              @id @default(autoincrement())
  userId    Int?
  user      User?            @relation(fields: [userId], references: [id])
  folderId  Int?
  folder    FlashcardFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  word      String
  phonetic  String?
  meaning   String
  example   String?
  topic     String?
  createdAt DateTime         @default(now())
  readingKey String? @unique
  sourceVersionId Int?
  notes String?
  reviews FlashcardReview[]

  @@index([folderId])
}

model TheoryLesson {
  id        Int      @id @default(autoincrement())
  title     String
  content   String // Nội dung bài học lý thuyết dạng markdown/text
  part      Int // 1 đến 7
  skillId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([part])
  @@index([skillId])
}

enum ExamType {
  FULL // 200 câu (100 Listening, 100 Reading)
  MINI // 100 câu rút gọn
  PART_5 // 30 câu chuyên sâu ngữ pháp/từ vựng
  CUSTOM // Các Part do người học chọn
}

model ExamAttempt {
  id             Int       @id @default(autoincrement())
  userId         Int
  examType       ExamType
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  questionIds    Int[]    @default([])
  deadlineAt DateTime?
  questionSnapshot Json?
  draftAnswers Json @default("[]")
  draftRevision Int @default(0)
  selectedParts  Int[]    @default([])
  listeningScore Int?
  readingScore   Int?
  totalScore     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@index([userId])
}

model ExamAnswer {
  id             Int      @id @default(autoincrement())
  attemptId      Int
  questionId     Int
  selectedAnswer String // "A", "B", "C", hoặc "D"
  isCorrect      Boolean
  createdAt      DateTime @default(now())

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  // Ngăn chặn trùng lặp câu trả lời trong cùng 1 lần thi ở mức database
  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model FlashcardFolder {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  userId      Int
  private Boolean @default(false)
  readingKey String? @unique
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  flashcards  Flashcard[]

  @@index([userId])
}

model ReadingArticle {
  id Int @id @default(autoincrement())
  ownerId Int?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  key String @unique
  originalText String
  title String
  status String @default("CREATING")
  error String?
  generationAttempts Int @default(0)
  currentVersionId Int?
  publishedVersionId Int?
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions ReadingVersion[]
  @@index([ownerId, archived])
}

model ReadingVersion {
  id Int @id @default(autoincrement())
  articleId Int
  article ReadingArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revision Int
  title String
  text String
  topic String
  kind String
  difficulty String
  origin String
  reviewed Boolean @default(false)
  questions Json
  createdAt DateTime @default(now())
  attempts ReadingAttempt[]
  reports ReadingReport[]
  @@unique([articleId, revision])
}

model ReadingAttempt {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionId Int
  version ReadingVersion @relation(fields: [versionId], references: [id])
  tryNumber Int
  activeKey String? @unique
  currentIndex Int @default(0)
  answers Json @default("{}")
  hints String[] @default([])
  correct Int?
  total Int?
  elapsedSeconds Int @default(0)
  startedAt DateTime @default(now())
  submittedAt DateTime?
  updatedAt DateTime @updatedAt
  aiEvents ReadingAiEvent[]
  @@unique([userId, versionId, tryNumber])
  @@index([userId, updatedAt])
}

model ReadingReport {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionId Int
  version ReadingVersion @relation(fields: [versionId], references: [id])
  questionIndex Int?
  reason String
  resolved Boolean @default(false)
  createdAt DateTime @default(now())
}

model ReadingAiEvent {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptId Int?
  attempt ReadingAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  action String
  status String
  inputChars Int
  outputChars Int @default(0)
  durationMs Int @default(0)
  error String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model FlashcardReview {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId Int
  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  known Boolean @default(false)
  reviewCount Int @default(0)
  intervalDays Int @default(0)
  dueAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recallWins Int @default(0)
  recallLosses Int @default(0)
  lastPracticedAt DateTime?
  contentHash String?
  schedulingSource String @default("fixed-interval")
  events FlashcardRecallEvent[]
  @@unique([userId, cardId])
  @@index([userId, dueAt])
}

model FlashcardRecallEvent {
  id Int @id @default(autoincrement())
  reviewId Int
  review FlashcardReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  attemptId String @unique
  requestHash String
  contentHash String
  recallMode String
  correct Boolean
  elapsedMs Int?
  lagDays Float
  priorWins Int
  priorLosses Int
  predictedRecall Float?
  schedulingSource String
  result Json
  occurredAt DateTime @default(now())
  @@index([reviewId, occurredAt])
}

model Das3hWeights {
  id        Int      @id @default(autoincrement())
  skillId   Int?     @unique
  skill     Skill?   @relation(fields: [skillId], references: [id])
  theta     Float[] // 10 trọng số cho 5 cửa sổ thời gian [c1, f1, c2, f2, ..., c5, f5]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2. Lịch sử vết làm bài theo từng skill
model StudentSkillHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId    Int
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  isCorrect  Boolean
  questionId Int
  createdAt  DateTime @default(now())

  @@index([userId, skillId, createdAt])
}

// 3. Bảng tổng hợp trình độ kỹ năng hiện tại của học sinh
model UserSkillMastery {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId       Int
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  masteryScore  Float    @default(0.5) // Giá trị xác suất [0.0, 1.0]
  lastPracticed DateTime @default(now())
  practiceCount Int      @default(0)

  @@unique([userId, skillId])
  @@index([userId])
}


model KnowledgeChunk {
  id          Int      @id @default(autoincrement())
  part        Int
  skillCode   String?
  category    String
  title       String
  content     String
  keywords    String[]
  lessonId    Int?
  reviewStatus String @default("DRAFT")
  sourceUri String?
  sourceVersion String?
  reviewedAt DateTime?
  reviewedBy String?
  approvedContentHash String?
  embeddings KnowledgeEmbedding[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([part])
  @@index([skillCode])
  @@index([category])
}

// Exact cosine search for the small reviewed corpus; no PostgreSQL extension required.
model KnowledgeEmbedding {
  id Int @id @default(autoincrement())
  knowledgeId Int
  knowledge KnowledgeChunk @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  chunkIndex Int
  model String
  dimensions Int
  sourceHash String
  content String
  vector Float[]
  createdAt DateTime @default(now())

  @@unique([knowledgeId, chunkIndex, model])
  @@index([model, knowledgeId])
}

model AiChatMessage {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  content     String
  contextData String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// A queue retry must not apply the same learning event twice.
model ProcessedMasteryJob {
  id          String   @id
  processedAt DateTime @default(now())
}

model ListeningSource {
  id Int @id @default(autoincrement())
  ownerId Int?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title String
  kind String
  url String
  videoId String?
  published Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  transcripts ListeningTranscript[]
  sessions ListeningSession[]
  reports ListeningReport[]
  @@index([ownerId, published])
}

model ListeningTranscript {
  id Int @id @default(autoincrement())
  sourceId Int
  segmentStart Float?
  segmentEnd Float?
  source ListeningSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  cacheKey String? @unique
  language String @default("en")
  version String
  provider String
  status String @default("PENDING")
  error String?
  attempts Int @default(0)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  units ListeningUnit[]
  sessions ListeningSession[]
  @@index([sourceId, createdAt])
}

model ListeningUnit {
  id Int @id @default(autoincrement())
  transcriptId Int
  transcript ListeningTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  position Int
  start Float
  end Float
  text String
  answers ListeningAnswer[]
  @@unique([transcriptId, position])
}

model ListeningSession {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId Int
  source ListeningSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  transcriptId Int?
  transcript ListeningTranscript? @relation(fields: [transcriptId], references: [id])
  start Float
  end Float
  currentIndex Int @default(0)
  mode String @default("CLOZE")
  difficulty String @default("MEDIUM")
  favorite Boolean @default(false)
  updatedAt DateTime @updatedAt
  answers ListeningAnswer[]
  @@index([userId, updatedAt])
}

model ListeningAnswer {
  id Int @id @default(autoincrement())
  sessionId Int
  session ListeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  unitId Int
  unit ListeningUnit @relation(fields: [unitId], references: [id])
  mode String
  difficulty String
  submitted String
  score Float
  feedback Json
  createdAt DateTime @default(now())
  @@index([sessionId, unitId])
}

model ListeningReport {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId Int
  source ListeningSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  reason String
  resolved Boolean @default(false)
  createdAt DateTime @default(now())
}

model ListeningSettings {
  id Int @id @default(1)
  maxSegmentSeconds Int @default(300)
  defaultSegmentSeconds Int @default(180)
  transcriptTtlHours Int @default(24)
  requestsPerHour Int @default(10)
  maxSubtitleBytes Int @default(200000)
  maxRecordingSeconds Int @default(60)
}

model MasteryOutbox {
  id String @id
  payload Json
  createdAt DateTime @default(now())
  processedAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastError String?
  @@index([processedAt, nextAttemptAt])
}
model LearningAttempt {
  id String @id
  userId Int
  kind String
  scopeId Int
  payloadHash String
  result Json
  createdAt DateTime @default(now())
}

// Calibration is versioned separately from the legacy heuristic ability.
model TrainedDas3hState {
  userId Int
  modelVersion String
  ability Float @default(0)
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, modelVersion])
}

// One completed response, regardless of the number of legacy micro-skills.
model TrainedDas3hObservation {
  id String @id
  userId Int
  sourceQuestionId String
  catalogHash String
  isCorrect Boolean
  occurredAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, catalogHash, occurredAt])
}
