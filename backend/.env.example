DATABASE_URL=postgresql://toeic:change-this-database-password@localhost:5432/toeic?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional path for admin-uploaded public Listening media. Private recordings stay in the browser.
# LISTENING_MEDIA_DIR=./storage/listening
LISTENING_ASR_ENABLED=false
LISTENING_ASR_PYTHON=python
LISTENING_ASR_MODEL_DIR=./storage/models/base.en
LISTENING_FFMPEG=ffmpeg

# Reading: UTC daily quotas; system library requires no AI calls.
READING_MAX_TEXT_CHARS=10000
READING_MAX_QUESTIONS=5
READING_GENERATIONS_PER_DAY=5
READING_TUTOR_PER_DAY=30
READING_AI_TIMEOUT_MS=45000
READING_TUTOR_MAX_CONTEXT_CHARS=12000

# Set to 1 only behind one trusted reverse proxy (Compose already sets it).
TRUST_PROXY=0

# Set after training + deployment-bridge validation; empty keeps the legacy heuristic.
# Relative paths resolve from the backend/application root.
DAS3H_MODEL_PATH=

# Optional held-out validated artifact from experiments/hlr/train.py (backend cwd).
# Empty: bounded experimental HLR prior for typed recall; self-report uses fixed intervals.
HLR_MODEL_PATH=
