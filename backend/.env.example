DATABASE_URL=postgresql://toeic:change-this-database-password@localhost:5432/toeic?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional path for admin-uploaded public Listening media. Private recordings stay in the browser.
# LISTENING_MEDIA_DIR=./storage/listening
LISTENING_ASR_ENABLED=false
LISTENING_ASR_PYTHON=python
LISTENING_ASR_MODEL_DIR=./storage/models/base.en
LISTENING_FFMPEG=ffmpeg

# Reading: UTC daily quotas; system library requires no AI calls.
READING_MAX_TEXT_CHARS=10000
READING_MAX_QUESTIONS=5
READING_GENERATIONS_PER_DAY=5
READING_TUTOR_PER_DAY=30
READING_AI_TIMEOUT_MS=45000
READING_TUTOR_MAX_CONTEXT_CHARS=12000
