POSTGRES_DB=toeic
POSTGRES_USER=toeic
POSTGRES_PASSWORD=change-this-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Cổng web trên máy chạy Docker. Đổi nếu cổng 8080 đã bị chương trình khác dùng (sửa FRONTEND_URL theo).
WEB_PORT=8080
# Cổng PostgreSQL/Redis chỉ dùng khi chạy kèm compose.dev.yaml để phát triển.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
FRONTEND_URL=http://localhost:8080
GEMINI_API_KEY=
OPENAI_API_KEY=

# Reading quotas/context for Docker deployment
READING_MAX_TEXT_CHARS=10000
READING_MAX_QUESTIONS=5
READING_GENERATIONS_PER_DAY=5
READING_TUTOR_PER_DAY=30
READING_TUTOR_MAX_CONTEXT_CHARS=12000
READING_AI_TIMEOUT_MS=45000

# Đăng ký bằng email: hệ thống gửi mã 6 chữ số để xác nhận; mã cùng loại dùng khi đặt lại mật khẩu.
# Gửi qua Gmail SMTP. SMTP_PASS là mật khẩu ứng dụng Gmail của SMTP_USER. Để trống SMTP_HOST thì mã được gửi vào Mailpit (http://localhost:8025).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=congau005@gmail.com
SMTP_PASS=
SMTP_FROM=TOEIC Adaptive <congau005@gmail.com>
# Cổng hộp thư thử nghiệm Mailpit trên máy chạy Docker
MAILPIT_PORT=8025
# Chỉ dùng khi chạy backend bằng Node mà chưa có SMTP: ghi mã ra log backend thay vì gửi email. Không bật khi triển khai.
OTP_DEV_LOG=false
# Khóa băm mã OTP; để trống thì dùng JWT_SECRET
OTP_SECRET=
# Đăng nhập bằng GitHub: tạo OAuth App tại https://github.com/settings/developers
# Authorization callback URL phải trùng GITHUB_REDIRECT_URI (mặc định FRONTEND_URL + /login/github, ví dụ http://localhost:8080/login/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
