# Paste into backend service Variables on Railway.
# Reference names assume database services are named Postgres and Redis.
# If your names differ, use Railway Add Reference to select their variables.
NODE_ENV=production
PORT=3000
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_USERNAME=${{Redis.REDISUSER}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET_AT_LEAST_32_CHARACTERS
FRONTEND_URL=https://REPLACE_WITH_YOUR_PROJECT.vercel.app
LISTENING_ASR_ENABLED=false
LISTENING_MEDIA_DIR=/app/storage/listening
